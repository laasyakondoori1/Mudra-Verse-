{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudraverse",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "pages_build_output_dir": "./dist/client"
}
